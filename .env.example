# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: API key from https://resend.com (free tier available).
# Required for contact/internship/early-access form submissions to be
# emailed to you. Without it, submissions are only logged to the server
# console and are NOT delivered anywhere.
RESEND_API_KEY="re_your_api_key"

# NOTIFY_EMAIL: the inbox that receives every form submission.
NOTIFY_EMAIL="you@example.com"

# NOTIFY_FROM (optional): the "from" address on notification emails.
# Defaults to Resend's shared onboarding@resend.dev sender, which works
# without any domain setup. Verify your own domain in Resend to use a
# custom "from" address instead.
NOTIFY_FROM="Mashnu AI Website <onboarding@resend.dev>"

# Supabase project config, used by @supabase/server to verify users and
# run client/admin supabase-js calls from API handlers.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"
# SUPABASE_SECRET_KEY: server-only secret, never expose client-side.
# Create/manage under Supabase dashboard > API Keys settings.
SUPABASE_SECRET_KEY="sb_secret_your_key"

# GROQ_API_KEY: API key from https://console.groq.com/keys. Powers the real
# AI Assistant chat responses (src/server/agentLogic.ts), and also the
# Content Strategist + Copy Producer roles on the internal /team page.
# Without it, the assistant falls back to a fixed "not configured" message,
# and those two team roles report a "needs_setup" status instead of a draft.
GROQ_API_KEY="gsk_your_api_key"

# TEAM_ADMIN_KEY: shared passphrase gating the internal /team page (the AI
# marketing team pipeline). Required — without it, /api/team/* always
# returns 401 and the dashboard can never unlock, even for you. Pick any
# long random string; it's checked via the x-team-key request header.
TEAM_ADMIN_KEY="choose_a_long_random_passphrase"

# The following are all optional and independent — the Publisher role on
# /team attempts each configured platform separately, so setting only one
# of these is enough to make that one platform go live; the rest keep
# reporting "needs_setup" until their own credentials are added.

# LINKEDIN_ACCESS_TOKEN: from a LinkedIn Developer App with the "Share on
# LinkedIn" product (w_member_social scope). Generate directly under the
# app's Auth tab → OAuth 2.0 tools → Create token. Expires in 60 days by
# default; regenerate manually, or add refresh-token support later.
# LINKEDIN_ACCESS_TOKEN="your_linkedin_token"

# TWITTER_API_KEY / TWITTER_API_SECRET / TWITTER_ACCESS_TOKEN /
# TWITTER_ACCESS_TOKEN_SECRET: all four required together. From
# developer.x.com → your app → Keys and tokens. Set "User authentication
# settings" to Read and Write before generating the Access Token and
# Secret. Posting requires a paid API tier — check current pricing at
# developer.x.com before assuming the free tier covers this.
# TWITTER_API_KEY="your_api_key"
# TWITTER_API_SECRET="your_api_key_secret"
# TWITTER_ACCESS_TOKEN="your_access_token"
# TWITTER_ACCESS_TOKEN_SECRET="your_access_token_secret"

# MEDIUM_INTEGRATION_TOKEN: from Medium → Settings → Security and apps →
# Integration tokens. Self-serve, no app review. Medium's public API has
# been in a legacy/maintenance state for a while — verify this still works
# when you set it up, since Medium could retire it without much notice.
# MEDIUM_INTEGRATION_TOKEN="your_medium_integration_token"
